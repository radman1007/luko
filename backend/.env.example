# ---------- Django ----------
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# مبدأهای مجاز فرانت (Vite dev + production)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Database (PostgreSQL) ----------
POSTGRES_DB=luko
POSTGRES_USER=luko
POSTGRES_PASSWORD=luko
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# برای چک سریع بدون Postgres می‌توانید موقتاً روی ۱ بگذارید (SQLite)
USE_SQLITE=0

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0
# دیتابیس‌های جدا برای cache و celery روی همان Redis
REDIS_CACHE_URL=redis://localhost:6379/1

# ---------- JWT ----------
# عمر توکن دسترسی (دقیقه) و توکن تمدید (روز)
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
