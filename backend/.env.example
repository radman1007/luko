# ---------- Django ----------
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# مبدأهای مجاز فرانت (Vite dev + production)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# دامنه‌هایی که مجازند فرمِ POST بفرستند — پنلِ ادمین بدونِ این ۴۰۳ می‌دهد
DJANGO_CSRF_TRUSTED_ORIGINS=
# هر دو فقط وقتی DEBUG=0 است اثر دارند
DJANGO_SSL_REDIRECT=1
DJANGO_HSTS_SECONDS=31536000

# ---------- Database (PostgreSQL) ----------
POSTGRES_DB=luko
POSTGRES_USER=luko
POSTGRES_PASSWORD=luko
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# برای چک سریع بدون Postgres می‌توانید موقتاً روی ۱ بگذارید (SQLite)
USE_SQLITE=0

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0
# دیتابیس‌های جدا برای cache و celery روی همان Redis
REDIS_CACHE_URL=redis://localhost:6379/1

# ---------- پنلِ ادمین ----------
# نشانیِ پنل. «admin» شناخته‌شده است و هر اسکنری اول همان را می‌زند.
# باید با بلوکِ location در deploy/nginx.arvan.conf یکی بماند.
DJANGO_ADMIN_URL=v1a2n3r4
# عمرِ نشستِ پنل (ساعت). فقط ادمین را تحت تأثیر می‌گذارد؛ خودِ اپ JWT دارد.
DJANGO_SESSION_HOURS=8

# ---------- JWT ----------
# عمر توکن دسترسی (دقیقه) و توکن تمدید (روز)
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# ---------- رمزنگاری ----------
# کلیدِ گاوصندوقِ رمز — نسخه‌ی خوانای رمز برای پشتیبانیِ تلفنی با این رمزنگاری
# می‌شود. خالی بودنش خطا نمی‌دهد، فقط گاوصندوق را بی‌صدا خاموش می‌کند و
# پشتیبانی «رمزی ثبت نشده» می‌بیند. هر رشته‌ی تصادفیِ بلند کافی است.
PASSWORD_VAULT_KEY=
# کلیدِ امضای لینکِ بازی‌ها. عوض کردنش لینک‌های صادرشده را باطل می‌کند.
GAME_LINK_SECRET=

# ---------- پیامک (OTP) ----------
# console      = چیزی ارسال نمی‌شود و کد فقط در لاگ می‌آید (توسعه)
# smsir        = ارائه‌دهنده‌ی فعلی؛ ما کد را می‌سازیم و او با «قالب کد تایید» می‌فرستد
# melipayamak  = ارائه‌دهنده‌ی قبلی؛ کد را خودِ سرویس می‌سازد
SMS_BACKEND=console
# ---------- ملی‌پیامک (قبلی) ----------
MELIPAYAMAK_API_KEY=
MELIPAYAMAK_BASE_URL=https://console.melipayamak.com
MELIPAYAMAK_TIMEOUT=12

# ---------- sms.ir ----------
# --- درگاهِ پرداختِ وندار (اشتراکِ فرزندان؛ apps/billing) ---
# کلیدِ درگاه از داشبوردِ وندار. IPِ سرور باید در وندار «مجاز» باشد و دامنه‌ی
# ثبت‌شده‌ی درگاه همان دامنه‌ی سایت؛ وگرنه ساختِ تراکنش رد می‌شود.
VANDAR_API_KEY=
# VANDAR_BASE_URL=https://ipg.vandar.io
# نشانیِ عمومیِ سایت (بازگشت از درگاه)؛ پیش‌فرض https://<LUKO_DOMAIN>
# SITE_URL=https://app.example.com

# کلید API از پنل sms.ir (سندباکس برای تست، پروداکشن برای انتشار)
SMS_IR_API_KEY=
# شناسه‌ی «قالب کد تایید» که در پنل sms.ir می‌سازید
SMS_IR_TEMPLATE_ID=
# نام پارامتر داخل همان قالب؛ مثلاً اگر متن قالب {CODE} است، همین را بگذارید
SMS_IR_PARAM_NAME=CODE
SMS_IR_BASE_URL=https://api.sms.ir
SMS_IR_TIMEOUT=10
# برگرداندن کد در پاسخ API برای تست (در پروداکشن حتماً 0)
OTP_EXPOSE_DEV_CODE=1

# ---------- داشبوردِ مدیریت (apps.dashboard) ----------
# نشانیِ پنهانِ داشبورد: https://<دامنه>/<DASHBOARD_PATH>/ — همان مقدار در deploy/dashboard.conf.
# بلند و تصادفی بسازید، مثلاً: echo "manage-$(openssl rand -hex 16)"
DASHBOARD_PATH=
# بی‌کاری بیش از این (دقیقه) نشست را می‌بندد؛ عمرِ کلِ نشست (ساعت)
DASHBOARD_IDLE_MINUTES=30
DASHBOARD_SESSION_HOURS=8
# کدِ پیامکیِ ورود به داشبورد (مرحله‌ی دوم). 0 = فقط شماره و رمز.
DASHBOARD_LOGIN_SMS=1

# ---------- وبلاگ ----------
# سایتِ لندینگ که پست‌ها را از /api/v1/blog/ می‌خواند (فقط همین‌ها CORS می‌گیرند)
BLOG_CORS_ORIGINS=https://luko.ir,https://www.luko.ir

