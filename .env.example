# ===========================================================================
# لوکو — پیکربندیِ استقرار. این فایل را به `.env` کپی کنید و پر کنید.
#   cp .env.example .env
# .env هرگز کامیت نمی‌شود.
# ===========================================================================

# ---------- دامنه ----------
# دامنه‌ای که هم فرانت و هم API روی آن سرو می‌شوند (یک origin)
LUKO_DOMAIN=app.example.com

# ---------- Django ----------
# کلید را با این دستور بسازید:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=app.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com

# اگر TLS را جای دیگری (مثلاً CDN آروان) تمام می‌کنید و به سرور http می‌رسد،
# این را 0 کنید تا حلقه‌ی ریدایرکت درست نشود.
DJANGO_SSL_REDIRECT=1

# CORS فقط وقتی لازم است که فرانت روی دامنه‌ی دیگری باشد.
# در چیدمانِ پیش‌فرض (یک origin) خالی بماند.
CORS_ALLOWED_ORIGINS=

# ---------- پایگاه‌داده ----------
POSTGRES_DB=luko
POSTGRES_USER=luko
POSTGRES_PASSWORD=
# در compose خودکار روی سرویسِ db تنظیم می‌شود
# POSTGRES_HOST=db
# POSTGRES_PORT=5432

# ---------- Redis ----------
# در compose خودکار: redis://redis:6379/0
# REDIS_URL=redis://redis:6379/0

# ---------- پیامک (OTP) ----------
# --- درگاهِ پرداختِ وندار (اشتراکِ فرزندان؛ apps/billing) ---
# کلیدِ درگاه از داشبوردِ وندار. IPِ سرور باید در وندار «مجاز» باشد و دامنه‌ی
# ثبت‌شده‌ی درگاه همان دامنه‌ی سایت؛ وگرنه ساختِ تراکنش رد می‌شود.
VANDAR_API_KEY=
# VANDAR_BASE_URL=https://ipg.vandar.io
# نشانیِ عمومیِ سایت (بازگشت از درگاه)؛ پیش‌فرض https://<LUKO_DOMAIN>
# SITE_URL=https://app.example.com

# smsir برای production؛ console یعنی کد فقط در لاگ می‌آید (توسعه)
SMS_BACKEND=smsir
SMS_IR_API_KEY=
SMS_IR_TEMPLATE_ID=
# در production حتماً 0 — وگرنه کدِ تأیید در پاسخِ API برمی‌گردد
OTP_EXPOSE_DEV_CODE=0

# ---------- هوش مصنوعی (AIaaSِ آروان‌کلاد؛ apps.ai) ----------
# نشانیِ گیت‌وی (سازگار با OpenAI) و کلید از پنلِ آروان؛ کلید فقط همین‌جا، هرگز در گیت.
# بی‌کلید همه‌چیز با متن‌های قاعده‌محور کار می‌کند و دستیار «به‌زودی» می‌گوید.
AI_BASE_URL=
AI_API_KEY=
# نامِ مدل‌ها همان‌طور که گیت‌وی در /v1/models می‌گوید
# AI_MODEL_FLASH=DeepSeek-V4-Flash
# AI_MODEL_PRO=DeepSeek-V4-Pro
# AI_MODEL_LUNA=GPT-5.6-Luna
# تحلیلِ پس‌زمینه‌ی فرزندِ مشترک: flash | pro | luna (رایگان همیشه flash)
# AI_INSIGHT_TIER_PREMIUM=pro
# سهمیه‌ی روزانه‌ی دستیار برای هر والد
# AI_QUOTA_FREE=5
# AI_QUOTA_PREMIUM_FLASH=40
# AI_QUOTA_PREMIUM_PRO=25
# AI_QUOTA_PREMIUM_LUNA=10

# ---------- کارایی ----------
# قاعده‌ی سرانگشتی: (۲ × تعدادِ هسته) + ۱
GUNICORN_WORKERS=3

# ---------- داشبوردِ مدیریت (apps.dashboard) ----------
# نشانیِ پنهانِ داشبورد: https://<دامنه>/<DASHBOARD_PATH>/ — همان مقدار در deploy/dashboard.conf.
# بلند و تصادفی بسازید، مثلاً: echo "manage-$(openssl rand -hex 16)"
DASHBOARD_PATH=
# بی‌کاری بیش از این (دقیقه) نشست را می‌بندد؛ عمرِ کلِ نشست (ساعت)
DASHBOARD_IDLE_MINUTES=30
DASHBOARD_SESSION_HOURS=8

# ---------- وبلاگ ----------
# سایتِ لندینگ که پست‌ها را از /api/v1/blog/ می‌خواند (فقط همین‌ها CORS می‌گیرند)
BLOG_CORS_ORIGINS=https://luko.ir,https://www.luko.ir

