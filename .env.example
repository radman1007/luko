# ===========================================================================
# لوکو — پیکربندیِ استقرار. این فایل را به `.env` کپی کنید و پر کنید.
#   cp .env.example .env
# .env هرگز کامیت نمی‌شود.
# ===========================================================================

# ---------- دامنه ----------
# دامنه‌ای که هم فرانت و هم API روی آن سرو می‌شوند (یک origin)
LUKO_DOMAIN=app.example.com

# ---------- Django ----------
# کلید را با این دستور بسازید:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=app.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com

# اگر TLS را جای دیگری (مثلاً CDN آروان) تمام می‌کنید و به سرور http می‌رسد،
# این را 0 کنید تا حلقه‌ی ریدایرکت درست نشود.
DJANGO_SSL_REDIRECT=1

# CORS فقط وقتی لازم است که فرانت روی دامنه‌ی دیگری باشد.
# در چیدمانِ پیش‌فرض (یک origin) خالی بماند.
CORS_ALLOWED_ORIGINS=

# ---------- پایگاه‌داده ----------
POSTGRES_DB=luko
POSTGRES_USER=luko
POSTGRES_PASSWORD=
# در compose خودکار روی سرویسِ db تنظیم می‌شود
# POSTGRES_HOST=db
# POSTGRES_PORT=5432

# ---------- Redis ----------
# در compose خودکار: redis://redis:6379/0
# REDIS_URL=redis://redis:6379/0

# ---------- پیامک (OTP) ----------
# --- درگاهِ پرداختِ وندار (اشتراکِ فرزندان؛ apps/billing) ---
# کلیدِ درگاه از داشبوردِ وندار. IPِ سرور باید در وندار «مجاز» باشد و دامنه‌ی
# ثبت‌شده‌ی درگاه همان دامنه‌ی سایت؛ وگرنه ساختِ تراکنش رد می‌شود.
VANDAR_API_KEY=
# VANDAR_BASE_URL=https://ipg.vandar.io
# نشانیِ عمومیِ سایت (بازگشت از درگاه)؛ پیش‌فرض https://<LUKO_DOMAIN>
# SITE_URL=https://app.example.com

# smsir برای production؛ console یعنی کد فقط در لاگ می‌آید (توسعه)
SMS_BACKEND=smsir
SMS_IR_API_KEY=
SMS_IR_TEMPLATE_ID=
# در production حتماً 0 — وگرنه کدِ تأیید در پاسخِ API برمی‌گردد
OTP_EXPOSE_DEV_CODE=0

# ---------- کارایی ----------
# قاعده‌ی سرانگشتی: (۲ × تعدادِ هسته) + ۱
GUNICORN_WORKERS=3
